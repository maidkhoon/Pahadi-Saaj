---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { INSTAGRAM_URL, STORE_NAME, STORE_TAGLINE } from '../consts';
const categories = ['All pieces', 'Ladies’ Suits', 'Sadriyaan'] as const;
---
<BaseLayout title="Pahadi Saaj | Traditional Wear, Thoughtfully Chosen" description="Discover traditional Indian wear at Pahadi Saaj. Explore our demo collection of Ladies’ Suits and Sadriyaan.">
<div class="announcement"><span>✦ A little tradition, a lot of you</span><span class="announcement-dot" aria-hidden="true">✦</span><span>Thoughtfully chosen. Rooted in heritage.</span></div>
<header class="site-header">
<a class="brand" href="#top" aria-label="Pahadi Saaj home"><span class="brand-mark" aria-hidden="true">PS</span><span class="brand-name"><strong>{STORE_NAME}</strong><small>ROOTED IN TRADITION</small></span></a>
<nav class="desktop-nav" aria-label="Main navigation"><a href="#collection">Shop all</a><a href="#categories">Collections</a><a href="#our-story">Our story</a><a href="#visit">Visit us</a></nav>
<div class="header-actions"><a class="header-link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a><button class="bag-button" type="button" id="bag-open" aria-label="Open demo shopping bag">Bag <span id="bag-count">0</span></button></div>
</header>
<main id="top">
<section class="hero" aria-labelledby="hero-title">
<div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span> THE PAHADI SAAJ EDIT</p><h1 id="hero-title">Tradition, with<br /><em>a fresh point of view.</em></h1><p class="hero-description">A considered collection of timeless Indian wear, beautiful details and pieces that feel like you. Find your next favourite, made for celebrations and everyday moments alike.</p><div class="hero-actions"><a class="button" href="#collection">Explore the collection <span aria-hidden="true">↘</span></a><a class="text-link" href="#our-story">Discover our story <span aria-hidden="true">↗</span></a></div><div class="hero-highlights"><span><b>✳</b> Heritage-inspired style</span><span><b>✳</b> Personal service</span></div></div>
<div class="hero-art" aria-label="Fashion editorial photograph"><div class="art-topline"><span>THE EVERYDAY EDIT</span><span>NO. 01 / PAHADI SAAJ</span></div><div class="art-sun"></div><div class="art-arch art-arch-back"></div><div class="art-arch art-arch-front"><div class="art-fabric"></div><div class="art-stitch"></div></div><div class="art-flower flower-one">✳</div><div class="art-flower flower-two">✳</div><div class="art-caption"><span>Tradition, reimagined</span><span>✦</span></div><div class="hero-photo-note">THE NEW CLASSICS <span>01 / 04</span></div></div>
</section>
<section class="ticker" aria-label="Brand message"><span>MADE FOR YOUR MOMENTS</span><span aria-hidden="true">✳</span><span>ROOTED IN TRADITION</span><span aria-hidden="true">✳</span><span class="ticker-extra">STYLE THAT FEELS LIKE HOME</span></section>
<section class="category-showcase section-wrap" id="categories"><div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> FIND YOUR FEEL</p><h2>Made for every <em>occasion.</em></h2></div><p class="section-intro">From graceful suit sets to classic layers, explore a little inspiration for your wardrobe.</p></div>
<div class="category-feature-grid">
<a class="category-feature category-feature-suits" href="#collection" data-category-link="Ladies’ Suits"><img src="https://images.unsplash.com/photo-1743229995505-d6374996df1c?auto=format&fit=crop&w=1000&q=85" alt="Traditional Indian embroidered outfit" loading="lazy"/><span class="category-feature-shade"></span><span class="category-feature-copy"><small>01 / THE FEMININE EDIT</small><strong>Ladies’ Suits</strong><span>Explore the edit ↗</span></span></a>
<a class="category-feature category-feature-sadri" href="#collection" data-category-link="Sadriyaan"><img src="https://images.unsplash.com/photo-1756483510767-35245638c057?auto=format&fit=crop&w=1000&q=85" alt="Traditional Indian attire inspiration" loading="lazy"/><span class="category-feature-shade"></span><span class="category-feature-copy"><small>02 / TIMELESS LAYERS</small><strong>Sadriyaan</strong><span>Explore the edit ↗</span></span></a>
</div></section>
<section class="collection section-wrap" id="collection" aria-labelledby="collection-title"><div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> CURATED WITH CARE</p><h2>The <em>collection.</em></h2></div><p class="section-intro">Find a style that speaks to you. These sample pieces show how the finished online store can look.</p></div>
<div class="collection-toolbar"><div class="category-tabs" role="group" aria-label="Filter products by category">{categories.map((category, index) => <button class:list={["category-tab", { active: index === 0 }]} type="button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}<span>{category === 'All pieces' ? products.length.toString().padStart(2, '0') : products.filter((product) => product.category === category).length.toString().padStart(2, '0')}</span></button>)}</div><span class="results-note">A LITTLE SOMETHING FOR YOU <span aria-hidden="true">✳</span></span></div>
<div class="product-grid" id="product-grid">{products.map((product) => <div class="product-grid-item" data-category={product.category}><ProductCard product={product} /></div>)}</div>
<p class="catalogue-note"><span aria-hidden="true">✳</span> Demo preview: product names, imagery and prices are illustrative and will be replaced with shop-approved details.</p></section>
<section class="editorial-band"><div class="editorial-band-image"></div><div class="editorial-band-copy"><p class="eyebrow"><span class="eyebrow-line"></span> THE ART OF DRESSING</p><h2>Some things never go<br />out of <em>style.</em></h2><p>Thoughtful details. Familiar traditions. A little something that makes an ordinary day feel special.</p><a class="button button-light" href="#collection">Find your favourite <span aria-hidden="true">↘</span></a></div></section>
<section class="story" id="our-story"><div class="story-stamp" aria-hidden="true"><span>LOCAL</span><strong>✳</strong><span>WITH LOVE</span></div><div class="story-copy"><p class="eyebrow"><span class="eyebrow-line"></span> A NOTE FROM US</p><h2>Good style is personal.<br /><em>So is good service.</em></h2><p>We believe the best pieces are the ones that feel like they belong to you. Pahadi Saaj brings together traditional inspiration and a warm, personal shopping experience.</p><a class="text-link" href="#visit">Come say hello <span aria-hidden="true">↗</span></a></div><div class="story-side"><span class="quote-mark">“</span><p>{STORE_TAGLINE}</p><span class="story-side-rule"></span><small>THE PAHADI SAAJ EDIT</small></div></section>
<section class="promise-strip"><div><span>✳</span><strong>Tradition-led style</strong><small>Inspired by timeless favourites</small></div><div><span>✳</span><strong>Personal attention</strong><small>A shopping experience with care</small></div><div><span>✳</span><strong>For every moment</strong><small>Everyday ease to special occasions</small></div></section>
<section class="visit section-wrap" id="visit"><div><p class="eyebrow"><span class="eyebrow-line"></span> LET’S CONNECT</p><h2>Found your <em>favourite?</em></h2><p>Ask us about sizing, current pricing and availability. We look forward to helping you find the right piece.</p></div><div class="visit-actions"><a class="button" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Connect on Instagram <span aria-hidden="true">↗</span></a><span class="visit-note">Shop contact and location details will be added once confirmed.</span></div></section>
</main>
<footer class="site-footer"><a class="brand footer-brand" href="#top"><span class="brand-mark">PS</span><span class="brand-name"><strong>{STORE_NAME}</strong><small>ROOTED IN TRADITION</small></span></a><span class="footer-center">A LITTLE TRADITION, A LOT OF YOU.</span><a class="footer-top" href="#top">BACK TO TOP ↑</a><span class="footer-bottom">© {new Date().getFullYear()} Pahadi Saaj · Client demo preview</span></footer>
<div class="bag-backdrop" id="bag-backdrop" hidden></div><aside class="bag-drawer" id="bag-drawer" aria-label="Demo shopping bag" aria-hidden="true"><div class="bag-drawer-head"><div><small>YOUR SELECTION</small><h2>Your bag <span id="drawer-bag-count">(0)</span></h2></div><button type="button" class="bag-close" id="bag-close" aria-label="Close bag">×</button></div><div id="bag-items" class="bag-items"><p class="bag-empty">Your bag is waiting for something lovely.</p></div><div class="bag-drawer-foot"><p>This is a frontend demo. Checkout and payments are not enabled yet.</p><button type="button" class="button bag-checkout" id="demo-checkout">Preview checkout <span aria-hidden="true">↗</span></button></div></aside><div class="demo-toast" id="demo-toast" role="status" aria-live="polite"></div>
<script>
const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
const items = document.querySelectorAll<HTMLElement>('.product-grid-item');
const bag = new Map<string, {name:string; image:string; price:string; qty:number}>();
const bagCount = document.querySelector<HTMLElement>('#bag-count');
const drawerCount = document.querySelector<HTMLElement>('#drawer-bag-count');
const bagItems = document.querySelector<HTMLElement>('#bag-items');
const drawer = document.querySelector<HTMLElement>('#bag-drawer');
const backdrop = document.querySelector<HTMLElement>('#bag-backdrop');
const toast = document.querySelector<HTMLElement>('#demo-toast');
let toastTimer: number | undefined;
function showToast(message:string) { if (!toast) return; toast.textContent = message; toast.classList.add('visible'); window.clearTimeout(toastTimer); toastTimer = window.setTimeout(() => toast.classList.remove('visible'), 2400); }
function renderBag() {
 const total = [...bag.values()].reduce((sum,item)=>sum+item.qty,0);
 if (bagCount) bagCount.textContent = String(total);
 if (drawerCount) drawerCount.textContent = '('+total+')';
 if (!bagItems) return;
 if (!bag.size) { bagItems.innerHTML = '<p class="bag-empty">Your bag is waiting for something lovely.</p>'; return; }
 bagItems.innerHTML = [...bag.entries()].map(([id,item]) => '<article class="bag-item"><img src="'+item.image+'" alt=""><div><strong>'+item.name+'</strong><small>'+item.price+'</small><div class="bag-item-controls"><button type="button" data-qty="-1" data-id="'+id+'" aria-label="Remove one">−</button><span>'+item.qty+'</span><button type="button" data-qty="1" data-id="'+id+'" aria-label="Add one">+</button><button type="button" class="bag-remove" data-remove="'+id+'">Remove</button></div></div></article>').join('');
}
function openBag() { drawer?.classList.add('open'); drawer?.setAttribute('aria-hidden','false'); if (backdrop) backdrop.hidden = false; document.body.classList.add('bag-open'); }
function closeBag() { drawer?.classList.remove('open'); drawer?.setAttribute('aria-hidden','true'); if (backdrop) backdrop.hidden = true; document.body.classList.remove('bag-open'); }
tabs.forEach((tab) => tab.addEventListener('click', () => {
 const filter = tab.dataset.filter;
 tabs.forEach((button) => { const active = button === tab; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
 items.forEach((item) => { item.hidden = filter !== 'All pieces' && item.dataset.category !== filter; });
}));
document.querySelectorAll<HTMLAnchorElement>('[data-category-link]').forEach(link=>link.addEventListener('click',()=>{const category=link.dataset.categoryLink;const target=[...tabs].find(tab=>tab.dataset.filter===category);target?.dispatchEvent(new Event('click'));}));
document.querySelectorAll<HTMLButtonElement>('[data-add-bag]').forEach(button=>button.addEventListener('click',()=>{const id=button.dataset.addBag||'';const card=button.closest('.product-card');const name=card?.querySelector('h3')?.textContent?.trim()||'Selected piece';const image=card?.querySelector('img')?.getAttribute('src')||'';const price=card?.querySelector('.product-price')?.textContent?.trim()||'Price on enquiry';const existing=bag.get(id);bag.set(id,{name,image,price,qty:(existing?.qty||0)+1});renderBag();showToast(name+' added to your demo bag');}));
document.querySelector('#bag-open')?.addEventListener('click',openBag);document.querySelector('#bag-close')?.addEventListener('click',closeBag);backdrop?.addEventListener('click',closeBag);
bagItems?.addEventListener('click',event=>{const target=event.target as HTMLElement;const id=target.dataset.id;if(target.dataset.remove){bag.delete(target.dataset.remove);renderBag();return;}if(id&&target.dataset.qty){const item=bag.get(id);if(item){item.qty+=Number(target.dataset.qty);if(item.qty<=0)bag.delete(id);else bag.set(id,item);renderBag();}}});
document.querySelector('#demo-checkout')?.addEventListener('click',()=>{closeBag();showToast('Checkout preview only — payments are not connected yet.');});
document.addEventListener('keydown',event=>{if(event.key==='Escape')closeBag();});
</script>
</BaseLayout>