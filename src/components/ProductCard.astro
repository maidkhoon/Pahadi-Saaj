---
import type { Product } from '../data/products';
interface Props { product: Product; }
const { product } = Astro.props;
---
<article class="product-card">
<a class="product-image-link" href="#visit" aria-label={`View details for ${product.name}`}>
<img class="product-image" src={product.image} alt={product.imageAlt} loading="lazy" width="600" height="720" />
<span class="product-tag">THE SAAJ EDIT</span><span class="product-image-action" aria-hidden="true">↗</span></a>
<div class="product-copy"><p class="product-category">{product.category}</p><h3>{product.name}</h3>
<p class="product-description">{product.description}</p><div class="product-bottom"><span class="product-price">{product.priceLabel}</span>
<button class="button button-small add-to-bag" type="button" data-add-bag={product.id}>Add to bag <span aria-hidden="true">+</span></button>
</div><p class="product-note">Sample product · Details to be confirmed</p></div>
</article>